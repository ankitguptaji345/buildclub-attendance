# Copy this file to a new file named ".env" in this same folder (backend/)
# and fill in your own values below for running the app on your own computer.
#
# In production (on Render), you do NOT upload this file - instead you type
# these same two names and values into Render's "Environment" tab. See the
# PDF guide for exact steps.

# Get this from your Neon project's dashboard (Connection Details -> Connection string)
DATABASE_URL=postgresql://your-neon-connection-string-here

# Pick your own secret word - this is the password needed to register a new face
ADMIN_PASSWORD=change-this-to-your-own-secret

# Only used when running locally. Render sets its own PORT automatically.
PORT=3000
